# Local VASP distribution copies; retain the small Patch B spec for deliberate review.
/vasp files/vasp.6.4.2-heide-cpu/
/vasp files/vasp-heide-patch-NEW/*
!/vasp files/vasp-heide-patch-NEW/heide_patch_b_spec.md

